<mxfile host="drawio" version="24.0.0"><diagram id="e2e" name="E2E flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="zdp" value="Data plane — hot path (target p99 overhead &lt; 30 ms)" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="230" y="40" width="720" height="440" as="geometry"/></mxCell><mxCell id="zmt" value="Metering — off the hot path" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="230" y="500" width="720" height="200" as="geometry"/></mxCell><mxCell id="zcp" value="Control plane" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="230" y="720" width="720" height="170" as="geometry"/></mxCell><mxCell id="cust" value="&lt;b&gt;Customer app&lt;/b&gt;&lt;br&gt;one platform key&lt;br&gt;&lt;i&gt;X-API-Key&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="160" height="80" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b&gt;Platform admin&lt;/b&gt;&lt;br&gt;(Stage 0: admin API&lt;br&gt;later: web console)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="770" width="160" height="80" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;Gateway (Go)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;① Authenticate key (hash lookup, expiry, revoked, IP allowlist)&lt;br&gt;② Route by API slug, check subscription &amp;amp; plan&lt;br&gt;③ Circuit breaker open? → 503, not charged&lt;br&gt;④ Limits + balance: one atomic Redis call&lt;br&gt;⑤ Inject provider credential, forward&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;retry GET/PUT/DELETE on 502/503/504/timeout&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;never retry a plain POST&lt;br&gt;⑥ Billable? 2xx–4xx yes · 5xx/timeout no → refund&lt;br&gt;⑦ Return response + X-Request-Id&lt;br&gt;⑧ Emit usage event (async)&lt;/div&gt;&lt;br&gt;&lt;i&gt;Works from an in-memory catalog snapshot — no DB on the hot path&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="360" height="360" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;rate limit · monthly quota&lt;br&gt;provider limit · prepaid balance" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="230" height="90" as="geometry"/></mxCell><mxCell id="prov" value="&lt;b&gt;Provider API&lt;/b&gt;&lt;br&gt;(production keys, billed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="180" width="230" height="60" as="geometry"/></mxCell><mxCell id="mock" value="&lt;b&gt;Mock server&lt;/b&gt;&lt;br&gt;(sandbox mk_test_ keys, free)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="260" width="230" height="50" as="geometry"/></mxCell><mxCell id="spool" value="&lt;b&gt;Disk spool&lt;/b&gt;&lt;br&gt;if the stream is down; replayed later" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="700" y="340" width="230" height="70" as="geometry"/></mxCell><mxCell id="stream" value="&lt;b&gt;Usage stream&lt;/b&gt;&lt;br&gt;Redis Streams (Stage 0–1) → Kinesis (Stage 2)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="260" y="540" width="300" height="70" as="geometry"/></mxCell><mxCell id="met" value="&lt;b&gt;Metering worker&lt;/b&gt;&lt;br&gt;batch → write → then ack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="600" y="540" width="170" height="70" as="geometry"/></mxCell><mxCell id="ch" value="&lt;b&gt;ClickHouse&lt;/b&gt;&lt;br&gt;call logs, 60 days&lt;br&gt;de-dup on request_id" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="790" y="530" width="150" height="90" as="geometry"/></mxCell><mxCell id="mettodo" value="&lt;i&gt;Next: post usage to the ledger in batches · hourly Redis-vs-ledger reconciliation · per-minute rollups feed dashboards and alerts (email + in-app)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="260" y="625" width="680" height="60" as="geometry"/></mxCell><mxCell id="cp" value="&lt;b&gt;Control plane (Go)&lt;/b&gt;&lt;br&gt;orgs (GSTIN check) · keys · subscriptions&lt;br&gt;prepaid top-ups · audit log&lt;br&gt;rebuilds Redis balances from the ledger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="260" y="760" width="300" height="90" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;orgs · keys (hashed) · APIs · plans&lt;br&gt;subscriptions · encrypted provider credentials&lt;br&gt;double-entry ledger (must balance, append-only) · audit" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="750" width="290" height="110" as="geometry"/></mxCell><mxCell id="e101" value="1. API call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cust" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e102" value="④ check + reserve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gw" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e103" value="⑤ forward" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gw" target="prov"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e104" value="sandbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gw" target="mock"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e105" value="fallback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="gw" target="spool"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e106" value="⑧ usage event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gw" target="stream"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e107" value="replay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="spool" target="stream"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e108" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stream" target="met"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e109" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="met" target="ch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e110" value="admin calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="admin" target="cp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e111" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cp" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e112" value="catalog refresh every 5 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="pg" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e113" value="top-up / rebuild balance" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="cp" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b style='font-size:14px'&gt;End-to-end flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Customer app calls &lt;code&gt;gw/{api}/{path}&lt;/code&gt; with its platform key.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Gateway checks the key, the subscription and the plan from its in-memory catalog.&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; One atomic Redis call checks rate limit, quota, provider limit and (prepaid) reserves the price. Any failure → 429 / 402 and nothing is consumed.&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Gateway swaps in the provider's credential (the customer's key never reaches the provider) and forwards. Sandbox keys go to the mock server for free.&lt;br&gt;&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Provider 5xx or timeout → not billed, reservation refunded.&lt;br&gt;&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; A usage event goes to the stream (or the disk spool if the stream is down).&lt;br&gt;&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Metering worker writes metadata-only call logs to ClickHouse and acknowledges only after the write.&lt;br&gt;&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Admin actions go through the control plane into PostgreSQL; the gateway picks up changes (new keys, revocations) within 5 seconds.&lt;br&gt;&lt;br&gt;&lt;span style='color:#666'&gt;Dashed = background / fallback paths.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="40" width="330" height="600" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>