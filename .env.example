# Copy to deploy/.env to override the local defaults in docker-compose.yml.
# These are LOCAL DEVELOPMENT values only. Generate real ones for any shared
# or production environment and keep them out of Git.

# 32-byte base64 key that encrypts provider credentials (internal/secrets).
# Generate a new one with:  openssl rand -base64 32
# Note: the seed data's sealed demo credential only decrypts with the default below.
MASTER_KEY=ZKQRA+uAzZ+IT4rvPLNxPCM4g5X3CAfQUuRCFGMimSs=

# Bearer token for the Stage 0 admin API (replaced by Google sign-in later).
ADMIN_TOKEN=dev-admin-token

LOG_LEVEL=info
